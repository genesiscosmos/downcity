{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/main/*"],
      "@downcity/agent": ["../../packages/agent/bin/index.d.ts"],
      "@downcity/agent/agent": ["../../packages/agent/bin/agent/index.d.ts"],
      "@downcity/city": ["../../packages/city/bin/index.d.ts"],
      "@downcity/agent/tools": ["../../packages/agent/bin/tools/index.d.ts"],
      "@downcity/federation": ["../../packages/federation/bin/index.d.ts"],
      "@downcity/city/local": ["../../packages/city/bin/local/index.d.ts"],
      "@downcity/powers": ["../../packages/implementations/powers/bin/index.d.ts"]
    }
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/common/**/*.ts", "electron.vite.config.ts"]
}
