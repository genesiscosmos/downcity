{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/main/*"],
      "@downcity/agent": ["../../packages/agent/bin/index.d.ts"],
      "downcity/agent-host": ["../../packages/cli/bin/agent-host/index.d.ts"]
    }
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/common/**/*.ts", "electron.vite.config.ts"]
}
