{
  "name": "@downcity/desktop",
  "version": "0.1.0",
  "description": "Downcity CLI 的跨平台桌面客户端。",
  "author": "Genesis Cosmos",
  "private": true,
  "type": "module",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && electron-vite build",
    "build:unpack": "pnpm build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@downcity/agent": "workspace:^",
    "@downcity/agent-registry": "workspace:^",
    "electron": "^40.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.6"
  }
}
