{
  "name": "@downcity/desktop",
  "version": "0.1.0",
  "description": "Downcity CLI 的跨平台桌面客户端。",
  "author": "Genesis Cosmos",
  "private": true,
  "type": "module",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "pnpm build:icon && electron-vite dev",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && electron-vite build",
    "build:icon": "bash scripts/build-icon.sh",
    "build:unpack": "pnpm build:icon && pnpm build && electron-builder --dir",
    "build:mac:app": "node scripts/build-mac-app.mjs",
    "package:mac": "electron-builder --config electron-builder.mac.yml --mac dmg zip --arm64 --prepackaged dist/mac-arm64/Downcity.app",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@downcity/agent": "workspace:^",
    "@downcity/city": "workspace:^",
    "@downcity/federation": "workspace:^",
    "@downcity/powers": "workspace:^",
    "@downcity/sandbox-microsandbox": "workspace:^",
    "@downcity/type": "workspace:*",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.18.2",
    "i18next": "^25.5.2",
    "katex": "^0.16.47",
    "marked": "^16.4.2",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mermaid": "^11.15.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-util-combine-extensions": "^2.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^16.0.0",
    "react-icons": "^5.5.0",
    "shiki": "^3.23.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "streamdown": "^1.6.11",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.2",
    "vite": "^7.1.6"
  }
}
