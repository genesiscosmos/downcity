{
  "name": "@downcity/ui",
  "version": "1.5.11",
  "description": "Downcity UI SDK for React and Tailwind CSS applications.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://downcity.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesiscosmos/downcity.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/genesiscosmos/downcity/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./src/styles.css",
    "./src/markdown.css",
    "./src/components/markdown/**/*.css",
    "./src/chat.css",
    "./src/status-panel.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./source.css": "./src/source.css",
    "./styles.css": "./src/styles.css",
    "./markdown.css": "./src/markdown.css",
    "./composer": {
      "types": "./dist/composer.d.ts",
      "import": "./dist/composer.js",
      "require": "./dist/composer.cjs"
    },
    "./chat.css": "./src/chat.css",
    "./status-panel.css": "./src/status-panel.css"
  },
  "files": [
    "dist",
    "src/source.css",
    "src/styles.css",
    "src/markdown.css",
    "src/components/markdown/**/*.css",
    "src/chat.css",
    "src/status-panel.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/composer.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/composer.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@pxlkit/core": "^1.3.3",
    "@pxlkit/effects": "^1.2.3",
    "@pxlkit/feedback": "^1.2.5",
    "@pxlkit/gamification": "^1.2.4",
    "@pxlkit/parallax": "^1.2.3",
    "@pxlkit/ui": "^1.2.5",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "katex": "^0.16.47",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-util-combine-extensions": "^2.0.1",
    "pele": "^1.6.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "rehype-sanitize": "^6.0.0",
    "streamdown": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.17.0",
    "framer-motion": "^11.18.2",
    "react-icons": "^5.5.0",
    "react-resizable-panels": "^4.11.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "@downcity/type": "workspace:*"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "downcity",
    "ui",
    "react",
    "tailwind",
    "agent"
  ]
}
