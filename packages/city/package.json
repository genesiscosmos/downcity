{
  "name": "@downcity/city",
  "version": "0.1.27",
  "type": "module",
  "description": "Downcity City 组合根、Plugin 生命周期与 Agent transport 运行时",
  "files": [
    "bin"
  ],
  "main": "./bin/index.js",
  "types": "./bin/index.d.ts",
  "exports": {
    ".": {
      "types": "./bin/index.d.ts",
      "import": "./bin/index.js"
    },
    "./local": {
      "types": "./bin/local/index.d.ts",
      "import": "./bin/local/index.js"
    },
    "./plugin": {
      "types": "./bin/plugin/index.d.ts",
      "import": "./bin/plugin/index.js"
    },
    "./plugin/react": {
      "types": "./bin/plugin/react.d.ts",
      "import": "./bin/plugin/react.js"
    },
    "./workspace": {
      "types": "./bin/workspace/index.d.ts",
      "import": "./bin/workspace/index.js"
    },
    "./shell": {
      "types": "./bin/shell/index.d.ts",
      "import": "./bin/shell/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc && tsc-alias -f && node scripts/rewrite-build-aliases.mjs && node scripts/verify-build-aliases.mjs",
    "migrate:plugin-config-v2": "node scripts/migrate-plugin-config-v2.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs test/local/*.test.mjs",
    "prepack": "npm run build && node ../../scripts/rewrite-workspace-dependencies.mjs prepare ./package.json",
    "postpack": "node ../../scripts/rewrite-workspace-dependencies.mjs restore ./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@downcity/agent": "workspace:^",
    "@downcity/federation": "workspace:^",
    "@downcity/type": "workspace:*",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.5",
    "globby": "^11.1.0",
    "hono": "^4.12.23",
    "node-pty": "1.2.0-beta.14",
    "pinyin-pro": "^3.27.0",
    "smol-toml": "^1.7.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "react": "^19.2.6",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
  }
}
