{
  "name": "@downcity/city",
  "version": "0.2.251",
  "description": "Downcity Federation runtime and SDK for Bureau identities, Agent terminals, services, auth, and env.",
  "type": "module",
  "main": "./bin/index.js",
  "module": "./bin/index.js",
  "exports": {
    ".": {
      "types": "./bin/index.d.ts",
      "import": "./bin/index.js"
    }
  },
  "types": "./bin/index.d.ts",
  "files": [
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesiscosmos/downcity.git",
    "directory": "packages/city"
  },
  "homepage": "https://downcity.ai",
  "bugs": {
    "url": "https://github.com/genesiscosmos/downcity/issues"
  },
  "keywords": [
    "downcity",
    "city",
    "ai",
    "runtime",
    "services"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsc && tsc -p tsconfig.test.json && node --test test/*.test.mjs",
    "prepack": "npm run build && node ../../scripts/rewrite-workspace-dependencies.mjs prepare ./package.json",
    "postpack": "node ../../scripts/rewrite-workspace-dependencies.mjs restore ./package.json",
    "version:patch": "node ../../scripts/bump-package-version.mjs ./package.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@downcity/type": "workspace:*",
    "ai": "^6.0.193",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "jose": "^6.2.3"
  }
}
