{
  "name": "@downcity/city",
  "version": "0.2.270",
  "description": "Compatibility entry for Federation APIs now owned by @downcity/federation.",
  "type": "module",
  "main": "./bin/index.js",
  "module": "./bin/index.js",
  "exports": {
    ".": {
      "types": "./bin/index.d.ts",
      "import": "./bin/index.js"
    }
  },
  "types": "./bin/index.d.ts",
  "files": [
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesiscosmos/downcity.git",
    "directory": "packages/city"
  },
  "homepage": "https://downcity.ai",
  "bugs": {
    "url": "https://github.com/genesiscosmos/downcity/issues"
  },
  "keywords": [
    "downcity",
    "city",
    "ai",
    "runtime",
    "services"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs",
    "prepack": "npm run build && node ../../scripts/rewrite-workspace-dependencies.mjs prepare ./package.json",
    "postpack": "node ../../scripts/rewrite-workspace-dependencies.mjs restore ./package.json",
    "version:patch": "node ../../scripts/bump-package-version.mjs ./package.json"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@downcity/federation": "workspace:*"
  }
}
