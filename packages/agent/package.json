{
  "name": "@downcity/agent",
  "version": "1.1.365",
  "type": "module",
  "description": "Downcity 单 Agent SDK 与执行运行时",
  "main": "./bin/index.js",
  "types": "./bin/index.d.ts",
  "exports": {
    ".": {
      "import": "./bin/index.js",
      "types": "./bin/index.d.ts"
    },
    "./agent": {
      "import": "./bin/agent/index.js",
      "types": "./bin/agent/index.d.ts"
    },
    "./city": {
      "import": "./bin/city/index.js",
      "types": "./bin/city/index.d.ts"
    },
    "./tools": {
      "import": "./bin/tools/index.js",
      "types": "./bin/tools/index.d.ts"
    },
    "./internal": {
      "import": "./bin/internal/index.js",
      "types": "./bin/internal/index.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/agent-compiler.mjs build",
    "dev": "node scripts/agent-compiler.mjs dev",
    "test": "pnpm build && pnpm --filter '@downcity/sandbox-*' build && pnpm -C ../plugins build && node --test scripts/*.test.mjs city-test/*.test.mjs",
    "test:executor-runtime": "pnpm build && node --test scripts/session-prompt-runtime.test.mjs",
    "typecheck": "node scripts/agent-compiler.mjs typecheck",
    "prepack": "npm run build && node ../../scripts/rewrite-workspace-dependencies.mjs prepare ./package.json",
    "postpack": "node ../../scripts/rewrite-workspace-dependencies.mjs restore ./package.json"
  },
  "dependencies": {
    "@downcity/workspace": "workspace:^",
    "@downcity/type": "workspace:*",
    "@downcity/federation": "workspace:^",
    "ai": "^6.0.193",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "globby": "^11.1.0",
    "hono": "^4.12.23",
    "js-yaml": "^4.1.1",
    "nanoid": "^5.1.11",
    "node-cron": "^4.2.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@downcity/sandbox-linux": "workspace:^",
    "@downcity/sandbox-macos": "workspace:^",
    "@downcity/sandbox-windows-mxc": "workspace:^",
    "@ai-sdk/openai": "^3.0.67",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
  }
}
