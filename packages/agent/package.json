{
  "name": "@downcity/agent",
  "version": "1.1.423",
  "type": "module",
  "description": "Downcity 单 Agent SDK 与执行运行时",
  "main": "./bin/index.js",
  "types": "./bin/index.d.ts",
  "exports": {
    ".": {
      "import": "./bin/index.js",
      "types": "./bin/index.d.ts"
    },
    "./agent": {
      "import": "./bin/agent/index.js",
      "types": "./bin/agent/index.d.ts"
    },
    "./tools": {
      "import": "./bin/tools/index.js",
      "types": "./bin/tools/index.d.ts"
    },
    "./session": {
      "import": "./bin/session/index.js",
      "types": "./bin/session/index.d.ts"
    },
    "./internal": {
      "import": "./bin/internal/index.js",
      "types": "./bin/internal/index.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/agent-compiler.mjs build",
    "dev": "node scripts/agent-compiler.mjs dev",
    "test": "pnpm build && node --test scripts/*.test.mjs",
    "test:executor-runtime": "pnpm build && node --test scripts/session-prompt-runtime.test.mjs",
    "typecheck": "node scripts/agent-compiler.mjs typecheck",
    "prepack": "npm run build && node ../../scripts/rewrite-workspace-dependencies.mjs prepare ./package.json",
    "postpack": "node ../../scripts/rewrite-workspace-dependencies.mjs restore ./package.json"
  },
  "dependencies": {
    "@downcity/type": "workspace:*",
    "diff": "^8.0.4",
    "fs-extra": "^11.3.5",
    "js-yaml": "^4.1.1",
    "nanoid": "^5.1.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
  }
}
