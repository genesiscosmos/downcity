{
  "name": "@downcity/local",
  "version": "0.2.4",
  "description": "Downcity 本地数据库基础设施与显式产品数据组件。",
  "type": "module",
  "main": "./bin/index.js",
  "module": "./bin/index.js",
  "types": "./bin/index.d.ts",
  "exports": {
    ".": {
      "types": "./bin/index.d.ts",
      "import": "./bin/index.js"
    },
    "./product": {
      "types": "./bin/product.d.ts",
      "import": "./bin/product.js"
    }
  },
  "files": [
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc && tsc-alias -f",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepack": "npm run build && node ../../scripts/rewrite-workspace-dependencies.mjs prepare ./package.json",
    "postpack": "node ../../scripts/rewrite-workspace-dependencies.mjs restore ./package.json",
    "version:patch": "node ../../scripts/bump-package-version.mjs ./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@downcity/agent": "workspace:^",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.1",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
  }
}
