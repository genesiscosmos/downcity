{
  "name": "@downcity/federation",
  "version": "1.6.8",
  "description": "Unified local and remote Federation SDK for user and admin access.",
  "type": "module",
  "main": "./bin/index.js",
  "module": "./bin/index.js",
  "exports": {
    ".": {
      "types": "./bin/index.d.ts",
      "import": "./bin/index.js"
    },
    "./node": {
      "types": "./bin/node/LoopbackLogin.d.ts",
      "import": "./bin/node/LoopbackLogin.js"
    }
  },
  "types": "./bin/index.d.ts",
  "files": [
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesiscosmos/downcity.git",
    "directory": "packages/federation"
  },
  "homepage": "https://downcity.ai",
  "bugs": {
    "url": "https://github.com/genesiscosmos/downcity/issues"
  },
  "keywords": [
    "downcity",
    "federation",
    "services",
    "auth"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsc && tsc -p tsconfig.test.json && node --test test/*.test.mjs",
    "prepack": "npm run build && node ../../scripts/rewrite-workspace-dependencies.mjs prepare ./package.json",
    "postpack": "node ../../scripts/rewrite-workspace-dependencies.mjs restore ./package.json",
    "version:patch": "node ../../scripts/bump-package-version.mjs ./package.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "better-sqlite3": "^13.0.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@downcity/type": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  }
}
