{
  "name": "@downcity/powers",
  "version": "1.5.7",
  "type": "module",
  "description": "Downcity 内建 power 集合包",
  "files": [
    "bin",
    "readmes",
    "styles"
  ],
  "main": "./bin/index.js",
  "types": "./bin/index.d.ts",
  "exports": {
    ".": {
      "types": "./bin/index.d.ts",
      "import": "./bin/index.js"
    },
    "./messenger": {
      "types": "./bin/messenger.d.ts",
      "import": "./bin/messenger.js"
    },
    "./memory": {
      "types": "./bin/memory.d.ts",
      "import": "./bin/memory.js"
    },
    "./presentation/styles.css": "./styles/presentation.css",
    "./presentation": {
      "types": "./bin/presentation.d.ts",
      "import": "./bin/presentation.js"
    },
    "./renderers": {
      "types": "./bin/renderers.d.ts",
      "import": "./bin/renderers.js"
    },
    "./skill": {
      "types": "./bin/skill.d.ts",
      "import": "./bin/skill.js"
    },
    "./task": {
      "types": "./bin/task.d.ts",
      "import": "./bin/task.js"
    },
    "./task/presentation": {
      "types": "./bin/task-presentation.d.ts",
      "import": "./bin/task-presentation.js"
    },
    "./web": {
      "types": "./bin/web.d.ts",
      "import": "./bin/web.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-presentation-catalog.mjs && node ../../../scripts/clean-package.mjs && tsc && tsc-alias -f",
    "dev": "pnpm build && concurrently -k -n tsc,alias \"tsc --watch --preserveWatchOutput\" \"tsc-alias -f --watch\"",
    "typecheck": "tsc --noEmit",
    "test:messenger-access": "pnpm build && node --test scripts/messenger-access.test.mjs",
    "test:messenger-config": "pnpm build && node --test scripts/messenger-channel-config.test.mjs",
    "test:power-host": "pnpm build && node --test scripts/power-host-actions.test.mjs",
    "test:messenger-storage": "pnpm build && node --test scripts/messenger-storage.test.mjs",
    "test:messenger-delivery": "pnpm build && node --test scripts/messenger-delivery.test.mjs",
    "test:messenger-inbound-parts": "pnpm build && node --test scripts/messenger-inbound-prompt-parts.test.mjs",
    "test:messenger-inbound-voice": "pnpm build && node --test scripts/messenger-inbound-voice.test.mjs",
    "test:exports": "pnpm build && node --test scripts/power-subpaths.test.mjs",
    "test:renderer": "node --test scripts/power-renderer-tokens.test.mjs",
    "test:presentation": "pnpm build && node --test scripts/presentation-components.test.mjs scripts/presentation-markdown.test.mjs",
    "test:memory": "pnpm build && node --test scripts/memory-power.test.mjs scripts/memory-web-host-actions.test.mjs",
    "test:skill": "pnpm build && node --test scripts/skill-power.test.mjs",
    "test:task": "pnpm build && node --test scripts/task-power.test.mjs",
    "test:web": "pnpm build && node --experimental-test-module-mocks --test scripts/web-power.test.mjs scripts/web-data-providers.test.mjs scripts/memory-web-host-actions.test.mjs scripts/playwright-browser-provider.test.mjs",
    "prepack": "npm run build && node ../../../scripts/rewrite-workspace-dependencies.mjs prepare ./package.json",
    "postpack": "node ../../../scripts/rewrite-workspace-dependencies.mjs restore ./package.json"
  },
  "dependencies": {
    "@downcity/agent": "workspace:^",
    "@downcity/city": "workspace:^",
    "@downcity/type": "workspace:*",
    "@larksuiteoapi/node-sdk": "^1.73.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "js-yaml": "^4.1.1",
    "node-cron": "^4.2.1",
    "playwright-core": "^1.62.1",
    "qrcode-generator": "^2.0.4",
    "smol-toml": "^1.7.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "react": "^19.2.6",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
  }
}
